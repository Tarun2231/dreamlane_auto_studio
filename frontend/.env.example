# API is same-origin by default: /api/...
# Optional explicit API base:
# NEXT_PUBLIC_API_URL=/api
# INTERNAL_API_BASE=http://127.0.0.1:3000/api
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:3000/api

# Optional branding (public site)
# NEXT_PUBLIC_SITE_NAME=Blacklane Auto Studio
# NEXT_PUBLIC_SITE_SHORT=DriveCare
# NEXT_PUBLIC_SITE_TAGLINE=Premium car detailing, restoration, and performance care.
# NEXT_PUBLIC_SITE_PHONE=+91 90000 00000
# NEXT_PUBLIC_SITE_EMAIL=support@blacklaneauto.com
# Service area shown before the visitor picks one — must match a city in SITE_LOCATION_OPTIONS (lib/site.ts). Default: Hyderabad.
# NEXT_PUBLIC_SITE_LOCATION=Hyderabad
# Optional WhatsApp (digits only, country code included, no +) — shows footer link to chat
# NEXT_PUBLIC_SITE_WHATSAPP=14155552671
