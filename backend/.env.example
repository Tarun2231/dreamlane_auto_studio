PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/car_service
JWT_SECRET=replace-with-strong-secret
ADMIN_EMAIL=admin@carcare.com
ADMIN_PASSWORD=admin123

CLOUDINARY_CLOUD_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-user
SMTP_PASS=your-pass
SMTP_FROM=noreply@carcare.com

# Optional: receive new quote requests + customer accept/decline alerts (defaults to JOB_SHEET_EMAIL if set)
# WORKSHOP_QUOTE_EMAIL=workshop@example.com

# Job sheet PDF branding (optional — used when generating / emailing job-sheet.pdf)
# JOB_SHEET_GARAGE_NAME=PARVIX GARAGE
# JOB_SHEET_TAGLINE=Premium Auto Care & Custom Works
# JOB_SHEET_LOCATION=Hyderabad
# JOB_SHEET_PHONE=9876543210
# JOB_SHEET_EMAIL=info@parvix.com
# JOB_SHEET_TECHNICIAN_NAME=Ravi Kumar
# JOB_SHEET_PAYMENT_MODE=UPI

# Invoice PDF (optional)
# INVOICE_PREFIX=PARVIX
# INVOICE_DUE_DAYS=0
# INVOICE_DISCOUNT_INR=0
# INVOICE_DISCOUNT_PCT=0
# INVOICE_BANK_NAME=ICICI Bank
# INVOICE_BANK_ACCOUNT=1234567890
# INVOICE_BANK_IFSC=ICIC0001234
# INVOICE_FOOTER_NOTE=Next service discount available.

# Automated “next service due” emails (optional — uses SMTP above)
# ENABLE_SERVICE_REMINDERS=true
# REMINDER_CRON=0 8 * * *
# REMINDER_GARAGE_NAME=Blackline Auto Studio
# REMINDER_SITE_URL=https://your-site.example.com
# PUBLIC_SITE_URL=https://your-site.example.com
